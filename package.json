{
  "name": "acorn",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('.next', { recursive: true, force: true })\"",
    "lint": "next lint",
    "test:unit": "node scripts/test-unit.mjs",
    "test:workflows": "node scripts/test-workflows.mjs",
    "test:verify": "node scripts/verify-all.mjs",
    "test": "node scripts/test-workflows.mjs && node scripts/verify-all.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.454.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
